rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own profile
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Public read for mock tests and study materials
    match /mockTests/{testId} {
      allow read: if true;
      allow write: if true;
    }

    match /studyMaterials/{materialId} {
      allow read: if true;
      allow write: if true;
    }

    // Test results
    match /testResults/{resultId} {
      allow read, write: if true;
    }

    // Inquiries from contact page
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Default rule
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
